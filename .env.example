# ============================================================
# Talking Avatar Platform - environment configuration
# 会说话的数字人平台 - 环境变量配置
# Copy to .env before running:  cp .env.example .env
# 运行前请复制为 .env 文件：cp .env.example .env
#
# Docker services (MariaDB / Redis / object storage / API / Worker)
# are intentionally NOT exposed to the host. Only the frontend
# nginx port APP_PORT is published; nginx proxies /api and /media
# to the internal network.
# Docker 内的服务 (MariaDB / Redis / 对象存储 / API / Worker)
# 默认不对宿主机暴露。只有前端 Nginx 的 APP_PORT 端口被暴露；
# Nginx 会将 /api 和 /media 的请求代理到内部网络。
# ============================================================

# --- App ---
# 管理后台端口 (Admin dashboard port)
APP_PORT=8080

# --- Hybrid deployment (Phase 2) / 混合部署 (第二阶段) ---
# The Python AI Worker runs natively on the macOS host to use the Apple
# Silicon GPU (MPS). It therefore needs Redis and the S3-compatible storage
# reachable from the host; these two ports are published for that purpose.
# Python AI Worker 在 macOS 宿主机上原生运行，以便使用 Apple Silicon GPU (MPS)。
# 因此，它需要从宿主机访问 Redis 和兼容 S3 的存储服务；这两个端口就是为此暴露的。
REDIS_HOST_PORT=6379
RUSTFS_HOST_PORT=9000

# --- Object storage (RustFS / S3-compatible) / 对象存储 (RustFS / S3 兼容) ---
# Inside the docker network the storage endpoint is http://rustfs:9000.
# 在 Docker 内部网络中，存储端点为 http://rustfs:9000。
S3_ENDPOINT=http://rustfs:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=talking-avatar
S3_USE_SSL=false

# Browser-accessible base URL for objects. In docker, nginx proxies /media to
# the internal storage service, so storage needs no host port. For production
# RustFS, point this at your public object URL and adapt nginx accordingly.
# 浏览器可访问的对象存储基础 URL。在 Docker 中，Nginx 将 /media 代理到
# 内部存储服务，所以存储本身不需要宿主机端口。如果在生产环境使用独立的
# 对象存储，请将此指向你的公网 URL 并相应修改 Nginx。
S3_PUBLIC_BASE_URL=http://localhost:8080/media


# --- MariaDB 11 / 数据库配置 ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=talking_avatar
MYSQL_USER=talking
MYSQL_PASSWORD=talking123

# --- Redis / 缓存与队列配置 ---
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
TASK_QUEUE_KEY=talking_avatar:tasks
LIVE_CONTROL_QUEUE_KEY=talking_avatar:live_control
AVATAR_INIT_QUEUE_KEY=talking_avatar:avatar_init

# Knowledge base retrieval service (rag-service microservice, Docker internal network)
# 知识库检索服务（rag-service 微服务，Docker 内网；一般无需修改）
# EMBED_SERVER_URL=http://service-rag:8001

# LLM for the audience chat -> avatar replies (OpenAI-compatible, DeepSeek).
# 大语言模型配置，用于观众聊天 -> 数字人回复 (兼容 OpenAI 接口，默认 DeepSeek)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-v4-flash

# Admin dashboard login (Please make sure to change the default password)
# 管理后台登录（请务必修改默认密码）
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin123

# --- API (internal only; reachable via nginx) / 内部 API 网关配置 ---
API_PORT=8080
API_BASE_URL=http://api:8080
GIN_MODE=release
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Audience client (frontend/live, standalone Next.js client)
# 观众端（frontend/live，独立 Next.js 客户端）
CLIENT_PORT=3000

# 1v1 Website (frontend/web, Next.js inside container 3000)
# 1v1 网站（frontend/web，Next.js 容器内 3000）
WEB_PORT=3001

# Telegram Mini App (frontend/telegram, Nginx inside container 80)
# Telegram Mini App（frontend/telegram，Nginx 容器内 80）
TG_PORT=3002

# --- Ngrok (Telegram Mini App local debugging) / Ngrok 内网穿透本地联调配置 ---
# Ngrok requires an auth token (https://dashboard.ngrok.com/get-started/setup)
# ngrok 需要认证 token（https://dashboard.ngrok.com/get-started/setup）
NGROK_AUTHTOKEN=

# Bot token: HMAC validation key for Telegram Mini App initData
# 机器人 token：Telegram Mini App initData 的 HMAC 校验密钥
TG_BOT_TOKEN=

# Ngrok agent API (docker service name, used for automatic public address discovery and webhook registration on startup)
# ngrok agent API（docker 服务名，用于启动时自动发现公网地址并注册 webhook）
NGROK_API_URL=http://ngrok:4040

# Production can fix webhook / Mini App address; empty fallback to ngrok auto-discovery
# 生产环境可固定 webhook / Mini App 地址；留空则回退 ngrok 自动发现
TG_WEBHOOK_URL=
TG_MINIAPP_URL=

# API gateway address called by TMA: empty = same origin /api; for local debugging fill ngrok api-gateway https address
# TMA 调用的 API 网关地址：留空 = 同源 /api；本地联调填 ngrok api-gateway 的
# https 地址，例如 https://xxxx.ngrok.app（构建 frontend-tg 时注入）
VITE_API_ORIGIN=

# --- AI Worker / AI 推理工作节点配置 ---
# mock = sleep 10s + synthesize script into speech (espeak-ng) + render video.
# The uploaded voice audio is passed to the TTS step as the clone reference.
# Later real models (GPT-SoVITS / LivePortrait) get their own AI_MODE value.
# mock 模式：仅睡眠 10s + 将脚本合成为语音 (espeak-ng) + 渲染占位视频。
# 上传的声音音频将作为克隆参考传递给 TTS 步骤。
# 真实的模型管线 (GPT-SoVITS / LivePortrait) 会被配置为 AI_MODE=real。
AI_MODE=real

# Local Qwen (OpenAI-compatible Chat Completions); keep secrets in .env only.
# OPENAI_API=chat_completions
# V2_QWEN_BASE_URL=http://your-host:18003/v1
# V2_QWEN_MODEL=qwen35
# V2_QWEN_API_KEY=
# Use resident IndexTTS/LatentSync for the live queue (worker config is separate).
# LIPSYNC_ENGINE=latentsync

# Private deployment origin; used by Compose and local Chrome extension packaging.
LINGCAST_PUBLIC_ORIGIN=
