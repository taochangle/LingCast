# ============================================================
# Hybrid local worker (Phase 2) / 混合本地 Worker 环境 (第二阶段)
#
# The Python AI Worker runs natively on the macOS host so it can use the
# Apple Silicon GPU (MPS), while MySQL/Redis/RustFS stay in Docker. Because the
# worker is on the host, it connects through the ports docker-compose now
# publishes (6379 / 9000).
# Python AI Worker 可以在 macOS 宿主机原生运行以调用 Apple Silicon GPU (MPS)，
# 而 MySQL/Redis/RustFS 等基础服务跑在 Docker 里。宿主机通过暴露的端口 (6379 / 9000) 连接。
#
# Usage / 使用方法:
#   cd worker
#   uv venv                                  # Python 3.11 (see .python-version) / 需 Python 3.11
#   uv sync --all-groups                     # install all deps from pyproject.toml + uv.lock / 安装依赖
#   cp .env.local.example .env.local
#   uv run python -u worker.py               # loads .env.local automatically; / 自动加载环境变量
#                                            # exported vars take precedence / 系统变量优先级最高
#
# Repo/model paths below are optional: the worker resolves sensible defaults
# under worker/external and worker/models automatically.
# 下面的仓库/模型路径是可选的：Worker 会自动从 worker/external 和 worker/models 解析默认路径。
# ============================================================

# Connect to dockerized services via published host ports.
# 连接到暴露端口的 Docker 服务
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
TASK_QUEUE_KEY=talking_avatar:tasks
LIVE_CONTROL_QUEUE_KEY=talking_avatar:live_control
AVATAR_INIT_QUEUE_KEY=talking_avatar:avatar_init
VIDEO_GEN_QUEUE_KEY=talking_avatar:video_gen

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=talking-avatar
S3_PUBLIC_BASE_URL=http://localhost:8080/media

API_BASE_URL=http://localhost:8080

# Real model pipeline (GPT-SoVITS + LivePortrait) on Apple Silicon.
# 真实大模型管线，支持 Apple Silicon
AI_MODE=real

# Linux + AMD ROCm (RX 6800 XT etc.) — run the worker in an official ROCm
# PyTorch container or a bare-metal ROCm install (see README):
# Linux + AMD ROCm 环境 — 在官方 ROCm 容器或宿主机上运行 (详见 README):
#   GPT_SOVITS_DEVICE=cuda
#   LIVEPORTRAIT_DEVICE=cuda
#   WAV2LIP_PROVIDER=rocm    # falls back to CPU per-node when ops are unsupported / 当算子不支持时回退 CPU
# For NVIDIA on Linux use WAV2LIP_PROVIDER=cuda instead.
# 对于 NVIDIA 显卡，请使用 WAV2LIP_PROVIDER=cuda。

# Optional overrides (defaults are resolved relative to the worker directory):
# 可选覆盖项 (默认值会基于 worker 目录自动解析):
# GPT_SOVITS_REPO=.../worker/external/GPT-SoVITS
# GPT_SOVITS_MODELS_DIR=.../worker/models/gpt-sovits
# GPT_SOVITS_DEVICE=mps
# GPT_SOVITS_PORT=9880
# GPT_SOVITS_PROMPT_TEXT=            # transcript of the reference audio / 参考音频的文本
# GPT_SOVITS_PROMPT_LANG=zh
# LIVEPORTRAIT_REPO=.../worker/external/LivePortrait
# LIVEPORTRAIT_MODELS_DIR=.../worker/models/liveportrait
# LIVEPORTRAIT_DEVICE=mps
# LIVEPORTRAIT_DRIVING=.../LivePortrait/assets/examples/driving/d1.pkl  # 仅默认路径；模板选择已移到 Avatar Studio 参数面板
# NOTE: drivingSpeed / drivingMultiplier / 裁剪 / 输出等可调参数已业务化：
#       在 Avatar Studio「LivePortrait 参数」面板配置，随 avatar_init 任务下发，Worker 不再读 env。
# WAV2LIP_MODELS_DIR=.../worker/models/wav2lip
# WAV2LIP_ONNX=.../worker/models/wav2lip/checkpoints/wav2lip_gan.onnx
# WAV2LIP_SCRFD=.../worker/models/wav2lip/scrfd/scrfd_2.5g_bnkps.onnx
# WAV2LIP_BACKEND=onnx          # onnx (default, fast) | torch (slow fallback) / onnx 默认且快速，torch 较慢仅作对照
# WAV2LIP_PROVIDER=             # auto (CoreML on macOS) | cpu
# WAV2LIP_THREADS=4             # cap onnxruntime CPU threads per session / 限制 ONNX 的 CPU 线程数
# WAV2LIP_FACE_SAMPLE_INTERVAL=5  # detect face every N frames (1 = every frame) / 每 N 帧进行一次人脸检测
# LIVEPORTRAIT_OUTPUT_FPS=24    # base video fps (default 24) / 基础视频帧率

# Face restoration (fixes Wav2Lip lip deformation; see worker/ai/enhancer.py):
# 人脸修复与增强 (解决 Wav2Lip 的嘴巴形变，见 worker/ai/enhancer.py):
#   FACE_ENHANCER=auto    # auto: codeformer (offline) / off (live) | off | gfpgan | codeformer
#   NOTE: the live pipeline NEVER applies face restoration — the watchdog
#   writer must sustain exactly 24fps and GFPGAN is ~1s/frame even on CoreML.
#   Offline broadcast uses CodeFormer by default.
#   注意：直播管线默认关闭面部修复 —— watchdog 需要保持严格 24fps，而 GFPGAN 在 CoreML 上仍需约 1s/帧。
#   离线播报默认使用 CodeFormer。
#   ENHANCER_PROVIDER=    # auto (CoreML on macOS) | cpu | cuda | rocm
#   ENHANCER_THREADS=4    # cap onnxruntime CPU threads for restoration / 限制修复器的 CPU 线程数
#   ENHANCER_MAX_FPS=0    # throttle enhancement (0 = every frame; 6 = ~6 fps) / 限制最高处理帧率
#   ENHANCER_ROI_PADDING=0.12      # expand the face ROI before restore (ratio) / 修复前扩展面部区域
#   ENHANCER_FEATHER_RATIO=0.15    # feathered mask edge falloff (ratio) / 羽化遮罩的边缘渐变比例
#   CODEFORMER_FIDELITY_WEIGHT=0.6  # CodeFormer quality/fidelity balance (0-1) / CodeFormer 的保真度权重
# Models: uv run python download_models.py --models restoration / 获取模型指令

# Live streaming worker (stream_worker.py):
# 直播 Worker 配置 (stream_worker.py):
#   uv run python -u stream_worker.py
# STREAM_RTMP_URL=rtmp://localhost:1935/live/{stream_id}   # SRS ingest / SRS 推流地址
# LIVE_CONTROL_QUEUE_KEY=talking_avatar:live_control      # start/stop 控制消息
# TTS_ENGINE=edge            # edge（默认，零 GPU）| gpt-sovits（旧克隆模型）
# Resident IndexTTS + LatentSync: configured by deploy_resident.py.
# LIPSYNC_ENGINE=latentsync
# TTS_ENGINE=indextts
# INDEXTTS_RESIDENT_URL=http://127.0.0.1:59411
# LATENTSYNC_RESIDENT_URL=http://127.0.0.1:59412
# RESIDENT_API_TOKEN=private-generated-token
# RESIDENT_S3_ENDPOINT=http://127.0.0.1:59490
# IDLE_MOTION_ENABLED=false
# base 视频时长/输出分辨率已移至 Avatar Studio「LivePortrait 参数」面板
# （liveportraitSettings.baseSeconds / outputWidth / outputHeight）
# STREAM_SUBTITLE_FONT=/System/Library/Fonts/STHeiti\ Medium.ttc  # 字幕中文字体
# STREAM_FFMPEG_LOG=/tmp/ffmpeg_<stream>.log

# ============================================================
# Private knowledge base (RAG) — legacy rag_worker.py has been REMOVED
# (along with its pymupdf / sentence-transformers deps).
# Knowledge now lives in the rag-service microservice (docker compose:
# zvec FTS + Jieba, zero model). The Go API calls it via EMBED_SERVER_URL
# (default http://rag-service:8001 inside compose). No worker env needed.
# 私有知识库 (RAG) — 旧的 rag_worker.py 已被移除 (及其依赖的 pymupdf / sentence-transformers)。
# 知识库现在作为独立微服务运行 (docker compose: rag-service，基于 zvec FTS + Jieba，零模型)。
# Go API 会通过 EMBED_SERVER_URL 调用它。Worker 环境不再需要关注此部分配置。
# ============================================================
